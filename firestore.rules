rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validSnapshot(uid, deviceId, providerId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'userId', 'deviceId', 'providerId', 'plan',
          'fetchedAt', 'syncedAt', 'expiresAt', 'stale', 'resources',
          'sourceVersion', 'errorSummary'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'userId', 'deviceId', 'providerId',
          'fetchedAt', 'syncedAt', 'expiresAt', 'stale', 'resources'
        ])
        && data.schemaVersion == 1
        && data.userId == uid
        && data.deviceId == deviceId
        && data.providerId == providerId
        && data.fetchedAt is string
        && data.syncedAt is string
        && data.expiresAt is string
        && data.stale is bool
        && data.resources is map
        && data.resources.size() <= 64
        && (!('plan' in data) || data.plan is string)
        && (!('sourceVersion' in data) || data.sourceVersion is string)
        && (!('errorSummary' in data) || (data.errorSummary is string && data.errorSummary.size() <= 300));
    }



    function validPeriod(period) {
      return period is map
        && period.keys().hasOnly(['tokens', 'estimatedCostUsd'])
        && period.keys().hasAll(['tokens'])
        && period.tokens is number
        && period.tokens >= 0
        && (!('estimatedCostUsd' in period) || (period.estimatedCostUsd is number && period.estimatedCostUsd >= 0));
    }

    function validDailyUsage(entry) {
      return entry is map
        && entry.keys().hasOnly(['date', 'tokens', 'estimatedCostUsd', 'finalized'])
        && entry.keys().hasAll(['date', 'tokens', 'finalized'])
        && entry.date is string && entry.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && entry.tokens is number && entry.tokens >= 0
        && entry.finalized is bool
        && (!('estimatedCostUsd' in entry) || (entry.estimatedCostUsd is number && entry.estimatedCostUsd >= 0));
    }
    function validDailyChunk(daily) {
      return daily is list && daily.size() <= 5
        && (daily.size() < 1 || validDailyUsage(daily[0]))
        && (daily.size() < 2 || validDailyUsage(daily[1]))
        && (daily.size() < 3 || validDailyUsage(daily[2]))
        && (daily.size() < 4 || validDailyUsage(daily[3]))
        && (daily.size() < 5 || validDailyUsage(daily[4]));
    }
    function validHistory(uid, deviceId, providerId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['schemaVersion', 'userId', 'deviceId', 'providerId', 'syncedAt', 'currency', 'periods', 'daily', 'storageVersion', 'chunkCount', 'dayCount'])
        && data.keys().hasAll(['schemaVersion', 'userId', 'deviceId', 'providerId', 'syncedAt', 'currency', 'periods', 'daily'])
        && data.schemaVersion == 1 && data.userId == uid && data.deviceId == deviceId && data.providerId == providerId
        && data.syncedAt is string && data.currency == 'USD'
        && data.periods is map && data.periods.keys().hasOnly(['today', 'yesterday', 'last30Days'])
        && (!('today' in data.periods) || validPeriod(data.periods.today))
        && (!('yesterday' in data.periods) || validPeriod(data.periods.yesterday))
        && (!('last30Days' in data.periods) || validPeriod(data.periods.last30Days))
        && ((!( 'storageVersion' in data) && !('chunkCount' in data) && !('dayCount' in data) && validDailyChunk(data.daily))
          || (data.storageVersion == 2 && data.daily == []
            && data.dayCount is int && data.dayCount >= 0 && data.dayCount <= 180
            && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 36
            && data.dayCount <= data.chunkCount * 5
            && ((data.dayCount == 0 && data.chunkCount == 0) || data.dayCount > (data.chunkCount - 1) * 5)));
    }
    function validHistoryChunk(uid, deviceId, providerId, chunkId) {
      let data = request.resource.data;
      return chunkId.matches('^([0-9]|[12][0-9]|3[0-5])$')
        && data.keys().hasOnly(['schemaVersion', 'userId', 'deviceId', 'providerId', 'syncedAt', 'chunkId', 'daily'])
        && data.keys().hasAll(['schemaVersion', 'userId', 'deviceId', 'providerId', 'syncedAt', 'chunkId', 'daily'])
        && data.schemaVersion == 1 && data.userId == uid && data.deviceId == deviceId && data.providerId == providerId
        && data.chunkId == chunkId && data.syncedAt is string
        && validDailyChunk(data.daily) && data.daily.size() > 0;
    }

    function validHealth(uid, deviceId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'userId', 'deviceId', 'updatedAt', 'engine', 'background', 'sync',
          'providerReadyCount', 'providerWarningCount', 'agentVersion'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'userId', 'deviceId', 'updatedAt', 'engine', 'background', 'sync',
          'providerReadyCount', 'providerWarningCount'
        ])
        && data.schemaVersion == 1
        && data.userId == uid
        && data.deviceId == deviceId
        && data.updatedAt is string
        && data.engine in ['ready', 'warning', 'missing', 'error']
        && data.background in ['ready', 'warning', 'missing', 'error']
        && data.sync in ['ready', 'warning', 'missing', 'error']
        && data.providerReadyCount is int && data.providerReadyCount >= 0 && data.providerReadyCount <= 64
        && data.providerWarningCount is int && data.providerWarningCount >= 0 && data.providerWarningCount <= 64
        && (!('agentVersion' in data) || (data.agentVersion is string && data.agentVersion.size() <= 120));
    }

    function validNotifications(notifications) {
      return notifications is map
        && notifications.keys().hasOnly(['lowQuota', 'reset'])
        && (!('lowQuota' in notifications) || notifications.lowQuota is bool)
        && (!('reset' in notifications) || notifications.reset is bool);
    }

    function validPreferenceTime(value) {
      let parts = value.split('T')[0].split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      return year >= 1
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,3})?Z$')
        && date.year() == year && date.month() == month && date.day() == day;
    }

    function validPreference(uid, family) {
      let data = request.resource.data;
      return data.keys().hasOnly(['schemaVersion', 'userId', 'family', 'enabled', 'updatedAt', 'notifications'])
        && data.keys().hasAll(['schemaVersion', 'userId', 'family', 'enabled', 'updatedAt'])
        && data.schemaVersion == 1
        && data.userId == uid
        && data.family == family
        && data.enabled is bool
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 64
        && validPreferenceTime(data.updatedAt)
        && family in ['codex', 'antigravity', 'claude', 'copilot', 'cursor', 'devin', 'grok', 'ollama', 'opencode', 'openrouter', 'zai']
        && (!('notifications' in data) || validNotifications(data.notifications));
    }

    function validPushProducer(uid, deviceId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['schemaVersion', 'userId', 'deviceId', 'publicKey', 'updatedAt'])
        && data.keys().hasAll(['schemaVersion', 'userId', 'deviceId', 'publicKey', 'updatedAt'])
        && data.schemaVersion == 1
        && data.userId == uid
        && data.deviceId == deviceId
        && data.publicKey is string
        && data.publicKey.size() > 0
        && data.publicKey.size() <= 256
        && data.updatedAt is string
        && data.updatedAt.size() <= 64
        && validPreferenceTime(data.updatedAt);
    }

    function validPushSubscription(uid, browserId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'userId', 'browserId', 'targetDeviceId', 'enrollmentEpoch',
          'applicationServerKey', 'endpoint', 'p256dh', 'auth', 'createdAt', 'expiresAt',
          'testRequestId', 'testRequestedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'userId', 'browserId', 'targetDeviceId', 'enrollmentEpoch',
          'applicationServerKey', 'endpoint', 'p256dh', 'auth', 'createdAt', 'expiresAt'
        ])
        && data.schemaVersion == 1
        && data.userId == uid
        && data.browserId == browserId
        && data.targetDeviceId is string && data.targetDeviceId.size() > 0 && data.targetDeviceId.size() <= 128
        && data.enrollmentEpoch is int && data.enrollmentEpoch >= 1
        && data.applicationServerKey is string && data.applicationServerKey.size() > 0 && data.applicationServerKey.size() <= 256
        && data.endpoint is string && data.endpoint.size() > 0 && data.endpoint.size() <= 2048
        && data.endpoint.matches('^https://(fcm[.]googleapis[.]com|updates[.]push[.]services[.]mozilla[.]com|[a-zA-Z0-9.-]+[.]push[.]apple[.]com)/.*')
        && data.p256dh is string && data.p256dh.size() > 0 && data.p256dh.size() <= 256
        && data.auth is string && data.auth.size() > 0 && data.auth.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 64 && validPreferenceTime(data.createdAt)
        && data.expiresAt is string && data.expiresAt.size() <= 64 && validPreferenceTime(data.expiresAt)
        && (!('testRequestId' in data) || (data.testRequestId is string && data.testRequestId.size() <= 128))
        && (!('testRequestedAt' in data) || (data.testRequestedAt is string && data.testRequestedAt.size() <= 64 && validPreferenceTime(data.testRequestedAt)));
    }

    function parseIsoTimestamp(value) {
      let parts = value.split('T');
      let dateParts = parts[0].split('-');
      let timeParts = parts[1].split('Z')[0].split('[.]');
      let hms = timeParts[0].split(':');
      let frac = timeParts.size() > 1 ? timeParts[1] : '0';
      let ms = frac.size() == 3 ? int(frac)
        : (frac.size() == 2 ? int(frac) * 10 : int(frac) * 100);
      return timestamp.date(int(dateParts[0]), int(dateParts[1]), int(dateParts[2]))
        + duration.value(int(hms[0]), 'h')
        + duration.value(int(hms[1]), 'm')
        + duration.value(int(hms[2]), 's')
        + duration.value(ms, 'ms');
    }

    function validResetCreditItem(item) {
      return item is map
        && item.keys().hasOnly(['creditId', 'expiresAt', 'status', 'resetType'])
        && item.keys().hasAll(['creditId', 'status', 'resetType'])
        && item.creditId is string && item.creditId.size() > 0 && item.creditId.size() <= 128
        && (item.expiresAt == null || (item.expiresAt is string && item.expiresAt.size() <= 64 && validPreferenceTime(item.expiresAt)))
        && item.status in ['available', 'redeeming', 'redeemed', 'unknown']
        && item.resetType in ['codexRateLimits', 'unknown'];
    }

    function resetProducerKeyMatches(uid, deviceId, publicKey) {
      return exists(/databases/$(database)/documents/users/$(uid)/pushProducers/$(deviceId))
        && get(/databases/$(database)/documents/users/$(uid)/pushProducers/$(deviceId)).data.publicKey == publicKey;
    }

    function validResetCredits(credits) {
      return credits is list && credits.size() <= 2
        && (credits.size() < 1 || validResetCreditItem(credits[0]))
        && (credits.size() < 2 || validResetCreditItem(credits[1]));
    }

    function validResetInventory(uid, deviceId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['version', 'type', 'publicKey', 'signature', 'observedAtTimestamp', 'expiresAtTimestamp', 'inventory'])
        && data.keys().hasAll(['version', 'type', 'publicKey', 'signature', 'observedAtTimestamp', 'expiresAtTimestamp', 'inventory'])
        && data.version == 1
        && data.type == 'inventory'
        && data.publicKey is string && data.publicKey.size() > 0 && data.publicKey.size() <= 256
        && resetProducerKeyMatches(uid, deviceId, data.publicKey)
        && data.signature is string && data.signature.size() > 0 && data.signature.size() <= 256
        && data.inventory is map
        && data.inventory.keys().hasOnly(['version', 'backendId', 'userId', 'targetDeviceId', 'accountId', 'observedAt', 'expiresAt', 'availableCount', 'credits'])
        && data.inventory.keys().hasAll(['version', 'backendId', 'userId', 'targetDeviceId', 'accountId', 'observedAt', 'expiresAt', 'availableCount'])
        && data.inventory.version == 1
        && data.inventory.backendId is string && data.inventory.backendId.size() > 0 && data.inventory.backendId.size() <= 128
        && data.inventory.userId == uid
        && data.inventory.targetDeviceId == deviceId
        && data.inventory.accountId is string && data.inventory.accountId.size() > 0 && data.inventory.accountId.size() <= 128
        && data.inventory.observedAt is string && data.inventory.observedAt.size() <= 64 && validPreferenceTime(data.inventory.observedAt)
        && data.inventory.expiresAt is string && data.inventory.expiresAt.size() <= 64 && validPreferenceTime(data.inventory.expiresAt)
        && data.observedAtTimestamp is timestamp
        && data.expiresAtTimestamp is timestamp
        && data.expiresAtTimestamp > data.observedAtTimestamp
        && data.expiresAtTimestamp - data.observedAtTimestamp <= duration.value(5, 'm')
        && data.observedAtTimestamp <= request.time + duration.value(1, 'm')
        && data.expiresAtTimestamp > request.time
        && data.inventory.availableCount is int && data.inventory.availableCount >= 0 && data.inventory.availableCount <= 100
        && (!('credits' in data.inventory) || data.inventory.credits == null || validResetCredits(data.inventory.credits));
    }

    function validResetCommand(command, uid, deviceId) {
      return command is map
        && command.keys().hasOnly(['version', 'commandId', 'idempotencyKey', 'creditId', 'accountId', 'targetDeviceId', 'userId', 'backendId', 'requestedAt', 'expiresAt'])
        && command.keys().hasAll(['version', 'commandId', 'idempotencyKey', 'creditId', 'accountId', 'targetDeviceId', 'userId', 'backendId', 'requestedAt', 'expiresAt'])
        && command.version == 1
        && command.commandId is string && command.commandId.size() > 0 && command.commandId.size() <= 128
        && command.idempotencyKey is string && command.idempotencyKey.size() > 0 && command.idempotencyKey.size() <= 128
        && command.creditId is string && command.creditId.size() > 0 && command.creditId.size() <= 128
        && command.accountId is string && command.accountId.size() > 0 && command.accountId.size() <= 128
        && command.targetDeviceId == deviceId
        && command.userId == uid
        && command.backendId is string && command.backendId.size() > 0 && command.backendId.size() <= 128
        && command.requestedAt is string && command.requestedAt.size() <= 64 && validPreferenceTime(command.requestedAt)
        && command.expiresAt is string && command.expiresAt.size() <= 64 && validPreferenceTime(command.expiresAt);
    }

    function validResetRequest(uid, deviceId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['version', 'browserId', 'producerPublicKey', 'leaseExpiresAt', 'requestedAtTimestamp', 'leaseExpiresAtTimestamp', 'command'])
        && data.keys().hasAll(['version', 'browserId', 'producerPublicKey', 'leaseExpiresAt', 'requestedAtTimestamp', 'leaseExpiresAtTimestamp', 'command'])
        && data.version == 1
        && data.browserId is string && data.browserId.size() > 0 && data.browserId.size() <= 128
        && data.producerPublicKey is string && data.producerPublicKey.size() > 0 && data.producerPublicKey.size() <= 256
        && resetProducerKeyMatches(uid, deviceId, data.producerPublicKey)
        && data.leaseExpiresAt is string && data.leaseExpiresAt.size() <= 64 && validPreferenceTime(data.leaseExpiresAt)
        && validResetCommand(data.command, uid, deviceId)
        && data.command.expiresAt == data.leaseExpiresAt
        && data.requestedAtTimestamp is timestamp
        && data.leaseExpiresAtTimestamp is timestamp
        && data.leaseExpiresAtTimestamp >= data.requestedAtTimestamp
        && data.leaseExpiresAtTimestamp - data.requestedAtTimestamp <= duration.value(10, 'm')
        && data.requestedAtTimestamp <= request.time + duration.value(1, 'm')
        && data.leaseExpiresAtTimestamp <= request.time + duration.value(11, 'm')
        && data.leaseExpiresAtTimestamp > request.time;
    }

    function validResetCreditResult(result, uid, deviceId, commandId) {
      return result is map
        && result.keys().hasOnly(['version', 'commandId', 'idempotencyKey', 'creditId', 'accountId', 'targetDeviceId', 'userId', 'backendId', 'state', 'code', 'executedAt', 'completedAt'])
        && result.keys().hasAll(['version', 'commandId', 'idempotencyKey', 'creditId', 'accountId', 'targetDeviceId', 'userId', 'backendId', 'state', 'code', 'executedAt'])
        && result.version == 1
        && result.commandId == commandId
        && result.idempotencyKey is string && result.idempotencyKey.size() > 0 && result.idempotencyKey.size() <= 128
        && result.creditId is string && result.creditId.size() > 0 && result.creditId.size() <= 128
        && result.accountId is string && result.accountId.size() > 0 && result.accountId.size() <= 128
        && result.targetDeviceId == deviceId
        && result.userId == uid
        && result.backendId is string && result.backendId.size() > 0 && result.backendId.size() <= 128
        && result.state in ['success', 'failed', 'unknown']
        && result.code in ['reset', 'nothingToReset', 'noCredit', 'alreadyRedeemed', 'account_mismatch', 'credit_expired', 'credit_missing', 'credit_status_invalid', 'credit_ambiguous', 'idempotency_conflict', 'command_expired', 'command_mutation_rejected', 'unknown_outcome', 'timeout', 'protocol_error', 'transport_error', 'reconcile_required', 'r3_authorization_required']
        && result.executedAt is string && result.executedAt.size() <= 64 && validPreferenceTime(result.executedAt)
        && (!('completedAt' in result) || (result.completedAt is string && result.completedAt.size() <= 64 && validPreferenceTime(result.completedAt)
          && parseIsoTimestamp(result.completedAt) >= parseIsoTimestamp(result.executedAt)));
    }

    function validResetResult(uid, deviceId, commandId) {
      let data = request.resource.data;
      return data.version == 1
        && (data.type == 'executing' || data.type == 'terminal')
        && data.publicKey is string && data.publicKey.size() > 0 && data.publicKey.size() <= 256
        && resetProducerKeyMatches(uid, deviceId, data.publicKey)
        && data.signature is string && data.signature.size() > 0 && data.signature.size() <= 256
        && data.backendId is string && data.backendId.size() > 0 && data.backendId.size() <= 128
        && data.userId == uid
        && data.targetDeviceId == deviceId
        && data.accountId is string && data.accountId.size() > 0 && data.accountId.size() <= 128
        && data.commandId == commandId
        && data.idempotencyKey is string && data.idempotencyKey.size() > 0 && data.idempotencyKey.size() <= 128
        && data.creditId is string && data.creditId.size() > 0 && data.creditId.size() <= 128
        && data.executedAt is string && data.executedAt.size() <= 64 && validPreferenceTime(data.executedAt)
        && ((data.type == 'executing'
            && data.keys().hasOnly(['version', 'type', 'publicKey', 'signature', 'backendId', 'userId', 'targetDeviceId', 'accountId', 'commandId', 'idempotencyKey', 'creditId', 'executedAt'])
            && data.keys().hasAll(['version', 'type', 'publicKey', 'signature', 'backendId', 'userId', 'targetDeviceId', 'accountId', 'commandId', 'idempotencyKey', 'creditId', 'executedAt']))
          || (data.type == 'terminal'
            && data.keys().hasOnly(['version', 'type', 'publicKey', 'signature', 'backendId', 'userId', 'targetDeviceId', 'accountId', 'commandId', 'idempotencyKey', 'creditId', 'executedAt', 'result'])
            && data.keys().hasAll(['version', 'type', 'publicKey', 'signature', 'backendId', 'userId', 'targetDeviceId', 'accountId', 'commandId', 'idempotencyKey', 'creditId', 'executedAt', 'result'])
            && validResetCreditResult(data.result, uid, deviceId, commandId)
            && data.result.backendId == data.backendId
            && data.result.accountId == data.accountId
            && data.result.idempotencyKey == data.idempotencyKey
            && data.result.creditId == data.creditId
            && data.result.executedAt == data.executedAt));
    }

    match /{path=**}/providers/{providerId} {
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/history/{providerId} {
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
    }



    match /{path=**}/historyChunks/{chunkId} {
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /users/{uid}/devices/{deviceId}/history/{providerId}/historyChunks/{chunkId} {
      allow get, list: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validHistoryChunk(uid, deviceId, providerId, chunkId);
      allow delete: if signedInAs(uid) && chunkId.matches('^([0-9]|[12][0-9]|3[0-5])$');
    }

    match /users/{uid}/devices/{deviceId}/history/{providerId} {
      allow get, list: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validHistory(uid, deviceId, providerId);
      allow delete: if false;
    }


    match /{path=**}/health/{healthId} {
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /users/{uid}/devices/{deviceId}/health/{healthId} {
      allow get: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && healthId == 'current' && validHealth(uid, deviceId);
      allow delete: if false;
    }

    match /users/{uid}/devices/{deviceId}/providers/{providerId} {
      allow get: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validSnapshot(uid, deviceId, providerId);
      allow delete: if false;
    }

    match /users/{uid}/preferences/{family} {
      allow get, list: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validPreference(uid, family);
      allow delete: if false;
    }

    match /users/{uid}/pushProducers/{deviceId} {
      allow get, list: if signedInAs(uid);
      allow create: if signedInAs(uid) && validPushProducer(uid, deviceId);
      allow update: if signedInAs(uid) && validPushProducer(uid, deviceId)
        && request.resource.data.publicKey == resource.data.publicKey;
      allow delete: if false;
    }

    match /users/{uid}/pushSubscriptions/{browserId} {
      allow get, list: if signedInAs(uid);
      allow create: if signedInAs(uid) && validPushSubscription(uid, browserId);
      allow update: if signedInAs(uid) && validPushSubscription(uid, browserId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testRequestId', 'testRequestedAt']);
      allow delete: if signedInAs(uid);
    }

    match /users/{uid}/devices/{deviceId}/resetControl/inventory {
      allow get: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validResetInventory(uid, deviceId);
      // Deletion only invalidates stale actionable UI state; it cannot authorize a provider mutation.
      allow delete: if signedInAs(uid);
    }

    match /users/{uid}/devices/{deviceId}/resetControl/request {
      allow get: if signedInAs(uid);
      allow create: if signedInAs(uid) && validResetRequest(uid, deviceId);
      allow update: if signedInAs(uid) && validResetRequest(uid, deviceId)
        && (
          request.time >= resource.data.leaseExpiresAtTimestamp
          || exists(/databases/$(database)/documents/users/$(uid)/devices/$(deviceId)/resetResults/$(resource.data.command.commandId))
        );
      allow delete: if false;
    }

    match /users/{uid}/devices/{deviceId}/resetResults/{commandId} {
      allow get, list: if signedInAs(uid);
      allow create: if signedInAs(uid) && validResetResult(uid, deviceId, commandId);
      allow update: if signedInAs(uid) && validResetResult(uid, deviceId, commandId)
        && resource.data.type == 'executing'
        && request.resource.data.type == 'terminal'
        && request.resource.data.commandId == resource.data.commandId
        && request.resource.data.idempotencyKey == resource.data.idempotencyKey
        && request.resource.data.creditId == resource.data.creditId
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.backendId == resource.data.backendId
        && request.resource.data.publicKey == resource.data.publicKey
        && request.resource.data.executedAt == resource.data.executedAt;
      allow delete: if false;
    }
  }
}
