{
  "name": "94ai-usage-dashboard",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/agent",
    "apps/web",
    "packages/core",
    "packages/firebase",
    "packages/openusage",
    "packages/client",
    "packages/ui"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.mjs && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:rules": "firebase emulators:exec --project demo-94aiusage --only firestore \"vitest run tests/firestore-rules.test.ts\"",
    "test:e2e": "playwright test",
    "usage": "npm run cli -w apps/agent --",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:acceptance": "firebase emulators:exec --project demo-94aiusage --only firestore \"vitest run tests/local-agent-firestore-acceptance.test.ts tests/firestore-web-acceptance.test.tsx tests/history-storage-acceptance.test.ts\"",
    "build:hosting": "node scripts/build-hosting.mjs",
    "audit:public": "node scripts/audit-public-release.mjs",
    "export:public": "node scripts/export-public-release.mjs",
    "verify:public-ready": "node scripts/verify-public-ready.mjs",
    "verify:public-release": "node scripts/verify-public-release.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.57.1",
    "firebase-tools": "^15.29.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
