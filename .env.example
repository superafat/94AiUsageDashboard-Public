# Public Firebase web configuration only. Copy to .env.local for Self-hosted mode.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Local Agent uses the same public Firebase project ID.
# Never place OAuth refresh tokens, Provider credentials, API secrets or service-account JSON here.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# OpenUsage engine selection is local-only: CLI first, fixed localhost HTTP fallback second.
# No remote OpenUsage URL or Provider credential belongs in this file.
